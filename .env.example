# Kopie als .env anlegen und eintragen (wird nicht versioniert).
# Empfohlen: Werte aussehen wie im Deployment auf dem Raspberry Pi.

# Netzwerk-Scanner (optional; ohne SCANNER_DEVICE wird auto-erkannt)
SCANNER_IP=
# SCANNER_DEVICE=hpaio:/net/officejet_4500_g510n-z?ip=<scanner-ip>&queue=false

# Optional: Basic-Auth-Schutz der Webanwendung (leer lassen = offen)
AUTH_USER=
AUTH_PASS=

# Paperless-ngx fuer den Button "An Paperless senden" (leer = deaktiviert)
PAPERLESS_URL=
PAPERLESS_TOKEN=

# Optional: Timeout je Scan (Sekunden, Default 180)
SCAN_TIMEOUT=180
# Optional: Timeout fuer ADF-Stapel (Sekunden, Default 300)
ADF_TIMEOUT=300
# Optional: Auto-Scan-Intervall ADF (Sekunden, Default 2.5)
AUTO_INTERVAL=2.5